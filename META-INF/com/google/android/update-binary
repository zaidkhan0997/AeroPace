#!/sbin/sh
##########################################################################################
# AeroPace Performance Engine - Universal Root Installer Engine
# Compatible with Magisk, KernelSU, and APatch
##########################################################################################

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD 2>/dev/null || echo "$1"
}

# Mount filesystems in recovery environment
mount /data 2>/dev/null
mount /cache 2>/dev/null
mount /system 2>/dev/null
mount /vendor 2>/dev/null

# Check for Magisk / KernelSU / APatch internal installer engines
if [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
    install_module
    exit 0
elif [ -f /data/adb/ksu/util_functions.sh ]; then
    . /data/adb/ksu/util_functions.sh
    install_module
    exit 0
elif [ -f /data/adb/ap/util_functions.sh ]; then
    . /data/adb/ap/util_functions.sh
    install_module
    exit 0
fi

# In-Manager execution: Magisk / KernelSU / APatch runs customize.sh directly.
# If flashed via custom recovery without environment preloaded:
ui_print "********************************************************"
ui_print "! Please flash this module via:"
ui_print "! - Magisk App (Modules -> Install from storage)"
ui_print "! - KernelSU App (Modules -> Install)"
ui_print "! - APatch App (Install Module)"
ui_print "********************************************************"
exit 1
